# Pick one backend: supabase (default) or postgres (local, via docker compose).
VITE_DB=supabase

# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Local Postgres through PostgREST (only used when VITE_DB=postgres)
VITE_POSTGREST_URL=http://localhost:3000

# Optional UI text
VITE_APP_TAGLINE=
VITE_DEFAULT_LOCATION=
